# Discord Bot Configuration
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_application_client_id_here

# Riot Games API
RIOT_API_KEY=RGAPI-your-riot-api-key-here
# Regional routing for ACCOUNT-V1 and MATCH-V5 (americas, europe, asia).
# BR, NA, LAN and LAS use americas.
RIOT_REGION=americas

# Database
DATABASE_PATH=data/koga.db

# Polling Interval (in minutes)
POLLING_INTERVAL_MINUTES=5
# Delay between API requests (in milliseconds) to respect rate limits
POLLING_DELAY_MS=1500
